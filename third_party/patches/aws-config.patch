+type endpointCredentialLookupHostProvider interface {
+	getEndpointCredentialLookupHost(context.Context) (func(context.Context, string) ([]string, error), bool, error)
+}
+
+func getEndpointCredentialLookupHost(ctx context.Context, configs configs) (lookup func(context.Context, string) ([]string, error), found bool, err error) {
+	for _, config := range configs {
+		if provider, ok := config.(endpointCredentialLookupHostProvider); ok {
+			lookup, found, err = provider.getEndpointCredentialLookupHost(ctx)
+			if err != nil || found {
+				break
+			}
+		}
+	}
+	return
+}
