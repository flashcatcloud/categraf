+
+// WithTransportConfigurer installs a per-client final transport policy. Copies
+// retain it, including SDK defaults-mode and metadata-service specializations.
+func (b *BuildableClient) WithTransportConfigurer(configure func(*http.Transport)) *BuildableClient {
+	cpy := b.clone()
+	cpy.transportConfigurer = configure
+	return cpy
+}
+func (b *BuildableClient) configuredTransport() *http.Transport {
+	tr := b.GetTransport()
+	if b.transportConfigurer != nil {
+		b.transportConfigurer(tr)
+	}
+	return tr
+}
