+					}
+					return dial(ctx, network, address)
+				}
+			}
+			dial := redirectPort(func(ctx context.Context, networkName, address string) (net.Conn, error) {
+				return (&net.Dialer{Timeout: time.Second}).DialContext(ctx, network(networkName), address)
+			})
