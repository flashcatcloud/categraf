+// WithAuthHTTPPolicy configures credential HTTP clients after SDK defaults and
+// mTLS setup, without replacing the business API transport or authentication.
+func WithAuthHTTPPolicy(configure func(*http.Client) *http.Client, lookup func(context.Context, string) ([]string, error)) ClientOption {
+	return authHTTPPolicy{configure: configure, lookup: lookup}
+}
+
+type authHTTPPolicy struct {
+	configure func(*http.Client) *http.Client
+	lookup    func(context.Context, string) ([]string, error)
+}
+
+func (p authHTTPPolicy) Apply(settings *internal.DialSettings) {
+	settings.AuthHTTPClientConfigurer = p.configure
+	settings.AuthLookupHost = p.lookup
+}
