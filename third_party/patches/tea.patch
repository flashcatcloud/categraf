 func ToInt32(a *int) *int32 {
 	return Int32(int32(IntValue(a)))
 }
+
+// ClientPool owns transports for a single SDK client and never changes the
+// process-wide default pool. Configure is called before each transport's use.
+type ClientPool struct {
+	clients       sync.Map
+	configure     func(*http.Transport)
+	networkPolicy func(string) string
+}
+
+func NewClientPool(configure func(*http.Transport), policies ...func(string) string) *ClientPool {
+	p := &ClientPool{configure: configure}
+	if len(policies) > 0 {
+		p.networkPolicy = policies[0]
+	}
+	return p
+}
+func (p *ClientPool) get(tag string) *teaClient {
+	if v, ok := p.clients.Load(tag); ok {
+		return v.(*teaClient)
+	}
+	v, _ := p.clients.LoadOrStore(tag, &teaClient{httpClient: &http.Client{}})
+	return v.(*teaClient)
+}
+func (p *ClientPool) CloseIdleConnections() {
+	p.clients.Range(func(_, value interface{}) bool {
+		client := value.(*teaClient)
+		client.Lock()
+		client.httpClient.CloseIdleConnections()
+		client.Unlock()
+		return true
+	})
+}
