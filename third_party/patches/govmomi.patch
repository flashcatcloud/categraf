+
+// SetTransportConfigurer applies a policy to a fresh client's owned transport.
+// Service clients and SDK tunnels inherit the policy and pool-cleanup group.
+// Configure before use; reconfiguration during requests is unsupported.
+func (c *Client) SetTransportConfigurer(configure func(*http.Transport)) {
+	c.transportConfigurer = configure
+	if configure == nil {
+		return
+	}
+	configure(c.t)
+	if c.transportGroup == nil {
+		c.transportGroup = &transportGroup{}
+	}
+	c.transportGroup.mu.Lock()
+	c.transportGroup.transports = append(c.transportGroup.transports, c.t)
+	c.transportGroup.mu.Unlock()
+}
+
+type transportGroup struct {
+	mu         sync.Mutex
+	transports []*http.Transport
+}
+
+func (g *transportGroup) closeIdle() {
+	g.mu.Lock()
+	transports := append([]*http.Transport(nil), g.transports...)
+	g.mu.Unlock()
+	for _, t := range transports {
+		t.CloseIdleConnections()
+	}
+}
